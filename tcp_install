#!/bin/bash

## Install build dependencies
sudo apt install git debhelper build-essential

## Build and intall the pagckage
git clone https://github.com/firdavis/tor-control-panel.git
cd tor-control-panel
dpkg-buildpackage -b
cd -
ls *deb > package-version
sudo apt install ./$(cat package-version) -y

## Run tor-control-panel which will complete
## it's own congiguration
tor-control-panel
